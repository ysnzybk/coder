APP_NAME="Site Teklif Paneli"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Firma siteleri bu adresin altında yayınlanır: APP_URL/firma-adi
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Canlıda (cPanel) MySQL kullanın; local deneme için sqlite yeterli
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Canlıda (https) true yapın
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Kendi SMTP hesabınız (Gmail için uygulama şifresi gerekir: smtp.gmail.com:587, Yandex: smtp.yandex.com:465)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Panel admin (php artisan db:seed ile oluşturulur) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google Places API (New) — Google Cloud Console'da "Places API (New)" etkin olmalı ---
# Aylık ücretsiz kota (Enterprise SKU ≈ 1.000 istek) içinde kalmak için uygulama içi sert sınırlar.
# Cloud Console'da ayrıca metot başına GÜNLÜK KOTA KAPAĞI koyun (README → Ücretsiz yapı).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_PAGES=3
GOOGLE_PLACES_MONTHLY_TEXT_LIMIT=900
GOOGLE_PLACES_MONTHLY_DETAILS_LIMIT=900

# --- Site metni sağlayıcısı: cloudflare (ücretsiz, varsayılan) | anthropic (ücretli) | template ---
LEADGEN_AI_PROVIDER=cloudflare

# --- Cloudflare Workers AI (ücretsiz): metin (Llama) + görsel (FLUX). Günlük 10.000 neuron ortak havuz ---
# Anahtar yoksa metin şablondan, görsel olmadan üretilir.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_TEXT_MAX_TOKENS=2200
CLOUDFLARE_DAILY_NEURON_BUDGET=9000
CLOUDFLARE_IMAGE_STEPS=2
CLOUDFLARE_HERO_IMAGE_STEPS=3
CLOUDFLARE_IMAGE_MAX_WIDTH=960
CLOUDFLARE_IMAGE_QUALITY=78
CLOUDFLARE_IMAGES_PER_SITE=3

# --- Claude API (ÜCRETLİ, isteğe bağlı): LEADGEN_AI_PROVIDER=anthropic ile açılır ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium

# --- Dosyadan içe aktarma (Overture CSV) ---
IMPORT_MIN_CONFIDENCE=0.6

# --- E-posta gönderim limiti (panelden de değiştirilebilir) ---
OUTREACH_MAIL_PER_HOUR=20
OUTREACH_MAIL_PER_DAY=100
