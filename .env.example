APP_NAME="Site Teklif Paneli"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Firma siteleri bu adresin altında yayınlanır: APP_URL/firma-adi
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Canlıda (cPanel) MySQL kullanın; local deneme için sqlite yeterli
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Kendi SMTP hesabınız (Gmail için uygulama şifresi gerekir: smtp.gmail.com:587, Yandex: smtp.yandex.com:465)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Panel admin (php artisan db:seed ile oluşturulur) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google Places API (New) — Google Cloud Console'da "Places API (New)" etkin olmalı ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_PAGES=3

# --- Claude API (site metinleri). Boşsa şablon içerik kullanılır ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium

# --- Cloudflare Workers AI (ücretsiz görsel üretimi). Boşsa siteler görselsiz üretilir ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_DAILY_IMAGE_LIMIT=80

# --- E-posta gönderim limiti (panelden de değiştirilebilir) ---
OUTREACH_MAIL_PER_HOUR=20
OUTREACH_MAIL_PER_DAY=100
